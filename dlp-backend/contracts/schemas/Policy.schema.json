{
  "$defs": {
    "PolicyAction": {
      "enum": [
        "allow",
        "warn",
        "block",
        "log",
        "redact",
        "quarantine",
        "revoke_share",
        "require_approval"
      ],
      "title": "PolicyAction",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "action": {
      "$ref": "#/$defs/PolicyAction"
    },
    "conditions": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "integer"
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          },
          {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          {
            "items": {
              "type": "integer"
            },
            "type": "array"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Conditions",
      "type": "object"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "enabled": {
      "default": true,
      "title": "Enabled",
      "type": "boolean"
    },
    "name": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "organization_id": {
      "format": "uuid",
      "title": "Organization Id",
      "type": "string"
    },
    "policy_id": {
      "format": "uuid",
      "title": "Policy Id",
      "type": "string"
    },
    "priority": {
      "default": 100,
      "minimum": 0,
      "title": "Priority",
      "type": "integer"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "version": {
      "default": 1,
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "policy_id",
    "organization_id",
    "name",
    "conditions",
    "action",
    "created_at",
    "updated_at"
  ],
  "title": "Policy",
  "type": "object"
}
