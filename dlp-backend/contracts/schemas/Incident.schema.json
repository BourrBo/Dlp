{
  "$defs": {
    "IncidentStatus": {
      "enum": [
        "open",
        "triaged",
        "investigating",
        "resolved",
        "closed"
      ],
      "title": "IncidentStatus",
      "type": "string"
    },
    "SeverityLevel": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "SeverityLevel",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assigned_to": {
      "anyOf": [
        {
          "maxLength": 256,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Assigned To"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "event_ids": {
      "default": [],
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Event Ids",
      "type": "array"
    },
    "finding_ids": {
      "default": [],
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Finding Ids",
      "type": "array"
    },
    "incident_id": {
      "format": "uuid",
      "title": "Incident Id",
      "type": "string"
    },
    "organization_id": {
      "format": "uuid",
      "title": "Organization Id",
      "type": "string"
    },
    "severity": {
      "$ref": "#/$defs/SeverityLevel"
    },
    "status": {
      "$ref": "#/$defs/IncidentStatus",
      "default": "open"
    },
    "title": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "incident_id",
    "organization_id",
    "title",
    "severity",
    "created_at",
    "updated_at"
  ],
  "title": "Incident",
  "type": "object"
}
