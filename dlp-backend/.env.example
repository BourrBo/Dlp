# Supabase project URL and server-only key. Never put the service role key
# in frontend build arguments, VITE_* variables, or source control.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# App
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:5173

# Google integrations are helper code only; OAuth routes are not exposed.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GCP_PROJECT_ID=
GMAIL_PUBSUB_SUBSCRIPTION_ID=
DLP_BACKEND_BASE_URL=http://127.0.0.1:8000

# Alerting
SLACK_WEBHOOK_URL=
DLP_ADMIN_API_KEY=
