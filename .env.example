# Copy this file to .env, then replace all placeholder values.
# Get these values from the Supabase project used by this deployment.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SERVICE_ROLE_KEY=sb_secret_replace_me
DLP_ADMIN_API_KEY=
# Platform (P2) database and token verification. Use a long random password.
PLATFORM_DB_PASSWORD=replace-with-a-long-random-password
PLATFORM_DB_USER=dlp_platform
PLATFORM_DB_NAME=dlp_platform
# Supabase > Project Settings > API (JWT secret) or your JWKS URL; one is required for /platform JWT sign-in.
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=
GITHUB_WEBHOOK_SECRET=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# During key rotation, list previous Fernet keys comma-separated until the queue drains.
SCAN_JOBS_ENCRYPTION_KEY=
SCAN_JOBS_PREVIOUS_ENCRYPTION_KEYS=
SLACK_WEBHOOK_URL=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GCP_PROJECT_ID=
GMAIL_PUBSUB_SUBSCRIPTION_ID=
DLP_BACKEND_BASE_URL=http://127.0.0.1:8000
DLP_DASHBOARD_BACKEND_URL=http://localhost:8000

# The dashboard's local URLs are the defaults for Docker Compose.
ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
DASHBOARD_PORT=3001
BACKEND_PORT=8000
