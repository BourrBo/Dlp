# Copy this file to .env, then replace all placeholder values.
# Get these values from the Supabase project used by this deployment.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SERVICE_ROLE_KEY=sb_secret_replace_me
DLP_ADMIN_API_KEY=
SLACK_WEBHOOK_URL=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GCP_PROJECT_ID=
GMAIL_PUBSUB_SUBSCRIPTION_ID=
DLP_BACKEND_BASE_URL=http://127.0.0.1:8000

# The dashboard's local URLs are the defaults for Docker Compose.
APP_ENV=production
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DASHBOARD_PORT=3000
BACKEND_PORT=8000
